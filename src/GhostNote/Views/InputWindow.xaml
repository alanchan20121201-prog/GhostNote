<Window x:Class="GhostNote.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GhostNote.Localization"
        Title="GhostNote"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 极简深色半透明输入框：圆角、无边框、无标题栏 -->
    <Border Margin="30"
            CornerRadius="16"
            Background="#F01B1D23"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" />
        </Border.Effect>

        <StackPanel Margin="26,18,26,16">
            <TextBlock Text="GHOSTNOTE"
                       FontSize="10"
                       Foreground="#59FFFFFF"
                       FontWeight="SemiBold" />

            <Grid Margin="0,8,0,0" Height="38">
                <TextBox x:Name="InputBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="24"
                         MaxLength="120"
                         Foreground="#F2FFFFFF"
                         CaretBrush="#FFFFFFFF"
                         SelectionBrush="#4D7AA2F7"
                         VerticalContentAlignment="Center"
                         TextChanged="OnTextChanged" />
                <TextBlock x:Name="Placeholder"
                           Text="{x:Static loc:Strings.InputPlaceholder}"
                           FontSize="24"
                           Foreground="#4DFFFFFF"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <Border Height="1" Background="#1FFFFFFF" Margin="0,10,0,10" />

            <TextBlock Text="{x:Static loc:Strings.InputHint}"
                       FontSize="11"
                       Foreground="#59FFFFFF" />
        </StackPanel>
    </Border>
</Window>
